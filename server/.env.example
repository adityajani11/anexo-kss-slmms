# MongoDB Atlas
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/SLMMS?retryWrites=true&w=majority
# Optional. Leave unset when the database name is already included in MONGO_URI.
MONGO_DB_NAME=SLMMS

NODE_ENV=production
PORT=5000
# Leave this as localhost when Nginx is on the same server.
HOST=127.0.0.1
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES=7d
REFRESH_EXPIRES=30d

# Comma-separated public frontend origins. No trailing slashes.
CLIENT_ORIGINS=https://your-project.vercel.app,https://www.example.com

# Used when the server generates PDFs containing MCQ images.
BASE_URL=https://api.example.com/api/v1

# Existing file storage: required while MCQs/materials continue to use S3.
AWS_REGION=ap-south-1
AWS_BUCKET=your-private-bucket
AWS_ACCESS_KEY=replace-me
AWS_SECRET_KEY=replace-me
S3_URL_EXPIRES=3600

# Required only if the WhatsApp/OTP feature is used.
WHATAPI_TOKEN=replace-me
WHATSAPP_API_URL=https://example.com/api/send
